# Vorlage für .env – kopieren, ausfüllen, NICHT committen (.gitignore deckt .env ab).
# Template for .env – copy, fill in, never commit.
#
# Alle Werte sind optional außer ROUTER_PASSWORD. In Klammern steht die Vorgabe.

# ─── Router ───────────────────────────────────────────────────────────────────
ROUTER_URL=http://192.168.1.1
# PFLICHT. Ohne diesen Wert bricht das Skript mit einer Meldung ab.
ROUTER_PASSWORD=dein_router_admin_passwort

# ─── Verbindungserkennung / Connection detection ──────────────────────────────
# IPv4-Präfix des Providers. Liegt die externe IP nicht darin, gilt die
# Verbindung als ausgefallen (1&1 Glasfaser = 94.134.).
GW_PREFIX=94.134.
VLAN_ID=7
WAN_NAME=1&1
# Wartezeit auf den PPPoE-Neuaufbau nach dem Toggle, in Schritten von
# CHECK_POLL_SEC abgefragt. (180 / 15)
# CHECK_WAIT_SEC=180
# CHECK_POLL_SEC=15

# ─── Quellen für die externe IP ───────────────────────────────────────────────
# Kommagetrennt, der Reihe nach abgefragt. Erst wenn ALLE schweigen, gilt die IP
# als nicht ermittelbar – und das zählt als Ausfall. Mehrere Quellen verhindern,
# dass die Störung eines einzelnen Dienstes einen Toggle auslöst.
#
# ACHTUNG: Der Abruf erzwingt IPv4 (curl -4). Auf Anschlüssen mit IPv6 liefern
# ifconfig.me und icanhazip.com sonst die IPv6-Adresse, die durch die
# IPv4-Prüfung fällt – der Rückfall wäre damit genau dann wirkungslos, wenn er
# gebraucht wird.
# IP_QUELLEN=https://api.ipify.org,https://ifconfig.me/ip,https://icanhazip.com
# IP_TIMEOUT_SEC=8

# ─── Karenzzeit ───────────────────────────────────────────────────────────────
# Ein Ausfall muss so lange ununterbrochen bestehen, bevor getoggelt wird. (120)
#
# WICHTIG: Die Schutzwirkung kommt nicht aus dieser Zahl, sondern daraus, dass
# beim ERSTEN Ausfall-Befund immer abgebrochen wird – es braucht stets zwei
# Läufe. Dieser Wert muss deshalb nur KLEINER als das Timer-Intervall sein.
# Ist er größer, verzögert er den Toggle um einen weiteren Lauf.
# Bei OnUnitActiveSec=5min in der Timer-Unit passen z. B. 120 s.
# GRACE_PERIOD_SEC=120

# ─── Backoff / Alarm (optional) ───────────────────────────────────────────────
# Bei unerwartetem Fehler (z. B. WAN-Verbindung fehlt komplett im Router) oder
# erfolglosem VLAN-Reset wird NICHT endlos neu versucht, sondern einmalig per
# Telegram zur manuellen Prüfung aufgefordert und danach pausiert.
# ALERT_COOLDOWN_SEC=21600     # Sperrzeit in Sekunden (6 h)
# MAX_RESET_FAILURES=1         # nach so vielen Fehl-Resets in Folge: Backoff
# STATE_FILE=/pfad/zur/glasfaser_watchdog_state.json   (Standard: neben dem Skript)

# ─── Absicherung gegen Config-Verlust ─────────────────────────────────────────
# Hintergrund im README. Die Verifikation nach dem Toggle wird mehrfach
# versucht, weil die Router-Oberfläche die Verbindungstabelle bei jedem
# Statuswechsel neu aufbaut und dabei kurz leer ist. Erst ein durchgehend
# negatives Ergebnis zählt als „Config zerstört".
# VERIFY_ATTEMPTS=3
# VERIFY_RETRY_SEC=5
# WAN_ROW_WAIT_MS=10000
# WAN_ROW_PROBES=3
# WAN_ROW_RETRY_MS=2000
# POST_TOGGLE_WINDOW_SEC=900
# NOTIFY_FIX_HIT=true          # meldet per Telegram, wenn ein Repaint abgefangen wurde
# DISABLE_FLAG=/pfad/zur/kill-switch-datei   (Standard: neben dem Skript)
# FORENSIC_DIR=/pfad/fuer/screenshots-traces-configbackups   (Standard: ./forensik)
# KEEP_BACKUPS=30

# ─── Abbruchsicherheit des Toggles ────────────────────────────────────────────
# Der Toggle besteht aus zwei Speichervorgängen (VLAN aus → warten → VLAN an).
# Schritt 1 wirkt sofort. Bricht der Lauf dazwischen ab, steht die Leitung ohne
# VLAN-ID da und kommt so nicht von allein zurück. Das Skript merkt sich diesen
# Zwischenzustand und repariert ihn beim nächsten Lauf – Vorrang vor jedem
# Backoff, denn Abwarten hilft nur, wenn der Router NICHT angefasst wurde.
# VLAN_REPAIR_MAX_TRIES=3      # danach Alarm statt weiterer Versuche
# VLAN_OFF_MAX_AGE_SEC=21600   # Marker älter als 6 h: melden statt blind reparieren
# MENU_TIMEOUT_MS=15000        # Wartezeit auf einen sichtbaren Menüpunkt

# ─── Telegram (optional) ──────────────────────────────────────────────────────
# Leer lassen, um Benachrichtigungen zu deaktivieren.
# Leave empty to disable notifications.
TELEGRAM_TOKEN=
TELEGRAM_CHAT=

# ─── Logging (optional) ───────────────────────────────────────────────────────
# Standard: glasfaser_watchdog.log im Skript-Verzeichnis
# LOG_FILE=/var/log/glasfaser_watchdog.log
