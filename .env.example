# ─── Router ───────────────────────────────────────────────────────────────────
ROUTER_URL=http://192.168.1.1
ROUTER_PASSWORD=your_router_admin_password

# ─── Verbindungserkennung / Connection detection ───────────────────────────────
# IP-Präfix des ISP (1&1 Glasfaser = 94.134.)
GW_PREFIX=94.134.
VLAN_ID=7
WAN_NAME=1&1
# Sekunden Wartezeit nach VLAN-Reset (Glasfaser braucht ~90s für PPPoE-Aufbau)
CHECK_WAIT_SEC=120

# ─── Backoff / Alarm (optional) ───────────────────────────────────────────────
# Bei unerwartetem Fehler (z. B. WAN-Verbindung fehlt komplett im Router) oder
# wiederholt erfolglosem VLAN-Reset wird NICHT endlos neu versucht, sondern
# einmalig per Telegram zur manuellen Prüfung aufgefordert und danach pausiert.
# ALERT_COOLDOWN_SEC: Sperrzeit (Sekunden) für erneute Versuche + Wiederhol-Alarme (Standard 6h)
# ALERT_COOLDOWN_SEC=21600
# MAX_RESET_FAILURES: nach so vielen Fehl-Resets in Folge → Backoff + Alarm (Standard 2)
# MAX_RESET_FAILURES=2
# STATE_FILE: Pfad zur Laufzeit-Statusdatei (Standard: neben dem Skript)
# STATE_FILE=/home/USER/glasfaser-watchdog/glasfaser_watchdog_state.json

# ─── Telegram (optional) ──────────────────────────────────────────────────────
# Leer lassen um Benachrichtigungen zu deaktivieren
# Leave empty to disable notifications
TELEGRAM_TOKEN=
TELEGRAM_CHAT=

# ─── Logging (optional) ───────────────────────────────────────────────────────
# Standard: glasfaser_watchdog.log im Skript-Verzeichnis
# LOG_FILE=/var/log/glasfaser_watchdog.log
