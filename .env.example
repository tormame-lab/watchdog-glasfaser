# ─── Router ───────────────────────────────────────────────────────────────────
ROUTER_URL=http://192.168.1.1
ROUTER_PASSWORD=your_router_admin_password

# ─── Verbindungserkennung / Connection detection ───────────────────────────────
# IP-Präfix des ISP (1&1 Glasfaser = 94.134.)
GW_PREFIX=94.134.
VLAN_ID=7
WAN_NAME=1&1
# Sekunden Wartezeit nach VLAN-Reset (Glasfaser braucht ~90s für PPPoE-Aufbau)
CHECK_WAIT_SEC=120

# ─── Telegram (optional) ──────────────────────────────────────────────────────
# Leer lassen um Benachrichtigungen zu deaktivieren
# Leave empty to disable notifications
TELEGRAM_TOKEN=
TELEGRAM_CHAT=

# ─── Logging (optional) ───────────────────────────────────────────────────────
# Standard: glasfaser_watchdog.log im Skript-Verzeichnis
# LOG_FILE=/var/log/glasfaser_watchdog.log
